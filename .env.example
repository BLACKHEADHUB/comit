# 복사해서 .env.local 로 만든 뒤 값을 채우세요. (.env.local 은 git에 올리지 않음)
# 모든 값은 서버 전용입니다. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.

# MongoDB Atlas 연결 문자열
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comit?retryWrites=true&w=majority

# Google Gemini (Flash 계열 모델명은 여기서 관리)
GEMINI_API_KEY=
GEMINI_MODEL=

# Upstash Redis (Rate Limit + AI 결과 캐싱)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
